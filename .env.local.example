# Copie ce fichier en .env.local et remplis avec ton projet Supabase
# (Supabase Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Panneau super-admin (/admin) — NE JAMAIS exposer / committer
# Clé service_role : Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role...
# Emails autorisés à accéder à /admin (séparés par des virgules)
ADMIN_EMAILS=ou@egzanp.com

# Envoi de courrier par l'APPLICATION (bienvenue, confirmation d'abonnement).
# Clé Resend distincte de celle que Supabase utilise pour l'authentification :
# l'une se révoque sans fermer l'autre porte. Droit « Sending access » seulement.
# Absente, les envois sont simplement sautés — c'est le cas en local et en
# préproduction, et c'est voulu.
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié chez Resend. Par défaut : PASRÈL <contact@pasrel.app>
MAIL_FROM=

# Secret de signature des liens d'invitation d'agent (/join).
# Génère-le une fois : openssl rand -base64 32
# À défaut, la clé service_role est utilisée — mais un secret dédié est
# préférable, il se change sans invalider l'accès à la base.
INVITE_SECRET=

# Domaine public du déploiement, utilisé dans les liens de vitrine et les
# messages WhatsApp envoyés aux clients.
#
# METTEZ-Y VOTRE PROPRE DOMAINE. Cette adresse part dans les liens que les
# marchands envoient à leurs clients : pointée sur un domaine qui ne vous
# appartient pas, elle enverrait leurs acheteurs chez quelqu'un d'autre.
#
# Laissé vide, le code retombe sur le domaine du déploiement officiel
# (https://pasrel.app). Si vous hébergez votre propre instance, mettez-y
# votre domaine — mieux vaut une URL moins jolie qu'une URL qui n'est pas
# la vôtre.
NEXT_PUBLIC_SITE_URL=
