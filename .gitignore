# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# env — tout sauf le modèle d'exemple.
#
# Une liste nommant les fichiers un par un laisse toujours passer le suivant :
# .env.staging, créé pour séparer la préproduction, n'y figurait pas et sa clé
# de service serait partie dans le dépôt au premier « git add -A ».
.env*
!.env.local.example

# sauvegardes : elles contiennent les données des marchands (et des pièces
# d'identité). Elles ne doivent jamais partir dans le dépôt.
/backups/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo

# design working files (maquettes) — gardés à part
# (décommente si tu ne veux pas versionner les maquettes)
# *.dc.html
# converza-mvp-screens.html

# ajouté par « npx vercel link » ; .env* est déjà couvert plus haut.
.vercel

# exports de base : ils contiennent les noms, telephones, clients et
# commandes des marchands. Ce depot est public — un dump telecharge pour
# verification ne doit jamais partir avec un « git add -A ».
*.sql.gz
*.dump
dumps/

# Environnement Python local (faster-whisper, outils media). Hors du depot.
.venv/
__pycache__/
